# Скопируйте в .env и заполните. Ключи: docker compose run --rm api python manage.py gen-key
ENV=dev                      # prod — выключает /api/docs и требует длинный SECRET_KEY
SECRET_KEY=
FERNET_KEY=                  # шифрование токенов интеграций в БД; НЕ МЕНЯТЬ после запуска
POSTGRES_PASSWORD=
SEARXNG_SECRET=
COOKIE_SECURE=false          # true, когда сайт работает по HTTPS

# LLM по умолчанию (организация может переопределить в Настройках → Модель)
LLM_BASE_URL=http://host.docker.internal:8080/v1   # MTPLX/Qwen на этом Mac
LLM_MODEL=
LLM_API_KEY=local
LLM_DISABLE_THINKING=true
